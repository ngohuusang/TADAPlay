<?xml version="1.0"?>
<configuration>
	<configSections>
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
	</configSections>
	<log4net>
		<!-- Console only. The file appender is NOT declared here on purpose: log4net builds and
		     opens every appender it finds, so merely declaring a RollingFileAppender would create
		     Log\tadaplay.log on every start even with no appender-ref pointing at it. Writing a
		     log file is opt-in (Cài đặt -> Nhật ký gỡ lỗi), so it is attached at runtime instead
		     by DebugLogger.SetFileLogging. -->
		<root>
          <level value="DEBUG" />
          <appender-ref ref="console" />
        </root>
        <appender name="console" type="log4net.Appender.ConsoleAppender">
          <layout type="log4net.Layout.PatternLayout">
            <conversionPattern value="%date %level %logger - %message%newline" />
          </layout>
        </appender>
	</log4net>
</configuration>
