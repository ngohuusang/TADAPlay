<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>3.33.1</Version>
    <!-- net6.0-windows, not net8: .NET 8 dropped Windows 7/8.1 support (needs Win10+), and
         some players/hosts run Windows 7. .NET 6 is the last runtime that still runs on
         Windows 7 SP1. LangVersion latest keeps the newer C# syntax the code was written in. -->
    <TargetFramework>net6.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- The bundled WireGuardNT wireguard.dll only ships as x86/x64 (no arm64 build), so force
         an x64 process even on Windows-on-ARM hosts - it runs fine under x64 emulation there,
         and wireguard.dll itself detects the true native OS architecture to install the
         correct kernel driver regardless of the calling process's bitness. Without this, an
         "AnyCPU" build on an ARM64 host produces a native ARM64 apphost that can't load
         either bundled DLL, failing with ERROR_BAD_FORMAT (0x8007000B). -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AntdUI" Version="2.0.9" />
    <PackageReference Include="log4net" Version="3.3.0" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="6.0.1" />
    <!-- .NET Core dropped the built-in single-byte codepages. AoE2 writes profile names in the
         machine's ANSI codepage, so decoding them needs 1252/1258 back. -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WireGuardNT-PInvoke\WireGuardNT-PInvoke.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\Log4net\log4net.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="x64\wireguard.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="x86\wireguard.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Plain manifest-resource embedding (read via Assembly.GetManifestResourceStream), not a
         .resx System.Byte[] ResXFileRef - deserializing a System.Byte[] .resx entry needs
         System.Resources.Extensions.dll at runtime, and that assembly isn't reliably present/
         working the same way across build configs: it worked for tiny resources in a
         framework-dependent Debug build, but the self-contained Release publish throws
         "MissingMethodException: Constructor on type 'System.Byte[]' not found" for every
         System.Byte[] resource regardless of size (found deploying WK-center.exe/WK-wide.exe,
         then again for the much smaller player.nfz.template). Manifest-resource streams have no
         such dependency, so they're the reliable choice for any embedded binary here. -->
    <EmbeddedResource Include="Resources\WK-center.exe">
      <LogicalName>TadaPlay.Resources.WK-center.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\WK-wide.exe">
      <LogicalName>TadaPlay.Resources.WK-wide.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\player.nfz.template">
      <LogicalName>TadaPlay.Resources.player.nfz.template</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\player.hki.template">
      <LogicalName>TadaPlay.Resources.player.hki.template</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
